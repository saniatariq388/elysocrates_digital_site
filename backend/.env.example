# Supabase Postgres connection string (use the Session pooler URI from
# Supabase Dashboard -> Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Shared with the Next.js app (root .env.local). Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Admin login. Login first checks the admin_users table (bcrypt hash).
# ADMIN_PASSWORD_HASH is only a fallback for a fresh database; create the real
# user with: uv run python scripts/create_admin.py
ADMIN_EMAIL=admin@elysocrates.digital
# Generate with: uv run python scripts/hash_password.py
ADMIN_PASSWORD_HASH=$2b$12$replace-with-bcrypt-hash

# Comma separated origins allowed to call the API directly
ALLOWED_ORIGINS=http://localhost:3001

# Supabase Storage (Dashboard -> Project Settings -> API)
# The service role key is server-side only; never expose it to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
SUPABASE_MEDIA_BUCKET=media
MAX_UPLOAD_MB=8
